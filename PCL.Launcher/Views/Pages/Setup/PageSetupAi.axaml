<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Setup.PageSetupAi">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10"
                    Grid.IsSharedSizeScope="True">
            <ui:MyCard Margin="0,15,0,15"
                       Title="{loc:Loc Setup.Ai.Connect.Title}">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock FontSize="13"
                               LineHeight="21"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Setup.Ai.Connect.Guide}" />

                    <Grid Margin="0,14,0,6"
                          ColumnDefinitions="Auto,20,*"
                          RowDefinitions="Auto,8,Auto,8,Auto">
                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Setup.Ai.BaseUrl}" />
                        <ui:MyTextBox x:Name="TxtBaseUrl"
                                      Grid.Row="0"
                                      Grid.Column="2"
                                      Height="32"
                                      HintText="https://api.deepseek.com" />
                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Setup.Ai.Model}" />
                        <ui:MyTextBox x:Name="TxtModel"
                                      Grid.Row="2"
                                      Grid.Column="2"
                                      Height="32"
                                      HintText="deepseek-chat" />
                        <TextBlock Grid.Row="4"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Setup.Ai.ApiKey}" />
                        <ui:MyTextBox x:Name="TxtApiKey"
                                      Grid.Row="4"
                                      Grid.Column="2"
                                      Height="32"
                                      PasswordChar="●"
                                      HintText="sk-..." />
                    </Grid>

                    <Grid Margin="0,10,0,4"
                          ColumnDefinitions="Auto,20,*,Auto">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{loc:Loc Setup.Ai.ModelList}" />
                        <ui:MyComboBox x:Name="ComboModels"
                                       Grid.Column="2"
                                       Height="32"
                                       IsVisible="False" />
                        <ui:MyButton x:Name="BtnFetchModels"
                                     Grid.Column="3"
                                     Height="32"
                                     MinWidth="120"
                                     Margin="8,0,0,0"
                                     Text="{loc:Loc Setup.Ai.FetchModels}" />
                    </Grid>
                    <Grid Margin="0,4,0,6"
                          ColumnDefinitions="Auto,20,*"
                          RowDefinitions="Auto,8,Auto">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{loc:Loc Setup.Ai.ContextLimit}" />
                        <ui:MyTextBox x:Name="TxtContextLimit"
                                      Grid.Column="2"
                                      Height="32" />
                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Setup.Ai.MaxOutput}" />
                        <ui:MyTextBox x:Name="TxtMaxOutput"
                                      Grid.Row="2"
                                      Grid.Column="2"
                                      Height="32" />
                    </Grid>

                    <ui:MyCheckBox x:Name="ChkEnableTools"
                                   Height="24"
                                   Margin="-1,6,0,4"
                                   Text="{loc:Loc Setup.Ai.EnableTools}" />
                    <ui:MyCheckBox x:Name="ChkAutoCrash"
                                   Height="24"
                                   Margin="-1,0,0,4"
                                   Text="{loc:Loc Setup.Ai.AutoCrash}" />

                    <WrapPanel Margin="0,10,0,0"
                               Orientation="Horizontal">
                        <ui:MyButton x:Name="BtnSaveTest"
                                     Height="34"
                                     MinWidth="118"
                                     Margin="0,0,8,8"
                                     ColorType="Highlight"
                                     Text="{loc:Loc Setup.Ai.SaveAndTest}" />
                        <ui:MyButton x:Name="BtnSave"
                                     Height="34"
                                     MinWidth="100"
                                     Margin="0,0,8,8"
                                     Text="{loc:Loc Common.Action.Save}" />
                        <ui:MyButton x:Name="BtnGetKey"
                                     Height="34"
                                     MinWidth="120"
                                     Margin="0,0,8,8"
                                     Text="{loc:Loc Setup.Ai.GetKey}" />
                        <ui:MyButton x:Name="BtnSkip"
                                     Height="34"
                                     MinWidth="100"
                                     Margin="0,0,8,8"
                                     Text="{loc:Loc Setup.Ai.Skip}" />
                    </WrapPanel>

                    <TextBlock x:Name="LabStatus"
                               Margin="2,6,2,0"
                               FontSize="12.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       Title="{loc:Loc Setup.Ai.Abilities.Title}">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock FontSize="13"
                               LineHeight="22"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Setup.Ai.Abilities.Body}" />
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       Title="{loc:Loc Setup.Ai.Privacy.Title}">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock FontSize="13"
                               LineHeight="22"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Setup.Ai.Privacy.Body}" />
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>
