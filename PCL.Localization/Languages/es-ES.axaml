<!-- Formatted by xaml-lang-formatter at 2026-06-28T17:16:52. -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xml:space="preserve">

    <!-- Meta -->

    <sys:String x:Key="Meta.Code">es-ES</sys:String>
    <sys:String x:Key="Meta.Name">Español (España)</sys:String>


    <!-- AI Assistant -->

    <sys:String x:Key="Common.Action.Save">Save</sys:String>
    <sys:String x:Key="Launch.Ai.Title">AI Assistant</sys:String>
    <sys:String x:Key="Launch.Ai.Input.Hint">Tell the AI what you want, e.g. "launch the game", "download 1.21.1", "disable incompatible mods"...</sys:String>
    <sys:String x:Key="Launch.Ai.Send">Send</sys:String>
    <sys:String x:Key="Launch.Ai.Cancel">Cancel current reply</sys:String>
    <sys:String x:Key="Launch.Ai.Clear">Clear chat</sys:String>
    <sys:String x:Key="Launch.Ai.Settings">Settings</sys:String>
    <sys:String x:Key="Launch.Ai.Settings.Tip">Settings / AI setup</sys:String>
    <sys:String x:Key="Launch.Ai.Account">Account</sys:String>
    <sys:String x:Key="Launch.Ai.Account.Login">Sign in</sys:String>
    <sys:String x:Key="Launch.Ai.Account.Title">Account</sys:String>
    <sys:String x:Key="Launch.Ai.Version">Select version</sys:String>
    <sys:String x:Key="Launch.Ai.Launch">Launch game</sys:String>
    <sys:String x:Key="Launch.Ai.CancelLaunch">Cancel launch</sys:String>
    <sys:String x:Key="Launch.Ai.PoweredBy">Let the AI do everything: launch, download versions, manage mods, analyze crashes</sys:String>
    <sys:String x:Key="Launch.Ai.Welcome">Hi, I am the PCL CE-AI AI assistant. You can ask me to launch the game, download or install versions, manage mods, analyze crash logs, or answer any launcher question.</sys:String>
    <sys:String x:Key="Launch.Ai.NotConfigured">No API key configured yet. I opened Settings - AI setup for you; fill it in to start chatting.</sys:String>
    <sys:String x:Key="Launch.Ai.Quick.Launch">Launch game</sys:String>
    <sys:String x:Key="Launch.Ai.Quick.Download">Install 1.21.1</sys:String>
    <sys:String x:Key="Launch.Ai.Quick.Mods">Manage mods</sys:String>
    <sys:String x:Key="Launch.Ai.Quick.Configure">Set up API</sys:String>
    <sys:String x:Key="Setup.Left.Category.Features">Features</sys:String>
    <sys:String x:Key="Setup.Left.Item.Features">Feature hub</sys:String>
    <sys:String x:Key="Setup.Left.Item.Ai">AI setup</sys:String>
    <sys:String x:Key="Setup.Features.Intro">The launcher's original download, instance and tool features all live here. The home page keeps only the AI chat and launch controls; you can also just ask the AI to do the work.</sys:String>
    <sys:String x:Key="Setup.Features.Download.Title">Download &amp; install</sys:String>
    <sys:String x:Key="Setup.Features.Download.Desc">Download the game, loaders, mods, modpacks, resource packs, shaders, worlds and datapacks.</sys:String>
    <sys:String x:Key="Setup.Features.Download.Install">Game install</sys:String>
    <sys:String x:Key="Setup.Features.Game.Title">Versions &amp; runtime</sys:String>
    <sys:String x:Key="Setup.Features.Game.Desc">Switch versions, adjust instance settings, view game logs and manage download tasks.</sys:String>
    <sys:String x:Key="Setup.Features.Game.InstanceSettings">Instance settings</sys:String>
    <sys:String x:Key="Setup.Features.Game.GameLog">Game log</sys:String>
    <sys:String x:Key="Setup.Features.Game.TaskManager">Task manager</sys:String>
    <sys:String x:Key="Setup.Features.Tools.Title">Tools &amp; multiplayer</sys:String>
    <sys:String x:Key="Setup.Features.Tools.Desc">Multiplayer lobby and built-in launcher utilities.</sys:String>
    <sys:String x:Key="Setup.Features.Ai.Title">AI assistant</sys:String>
    <sys:String x:Key="Setup.Features.Ai.Desc">Everything above can also be done by natural language, e.g. "download 1.21.1 with Fabric" or "disable OptiFine".</sys:String>
    <sys:String x:Key="Setup.Features.Ai.Go">Open AI setup</sys:String>
    <sys:String x:Key="Setup.Features.Ai.Home">Back to home</sys:String>
    <sys:String x:Key="Setup.Features.NoInstance">No version selected yet. Please pick one first.</sys:String>
    <sys:String x:Key="Setup.Ai.Connect.Title">Connect the AI assistant</sys:String>
    <sys:String x:Key="Setup.Ai.Connect.Guide">An OpenAI-compatible endpoint is required. DeepSeek is recommended:&#xA;1. Open platform.deepseek.com, sign up and create an API key;&#xA;2. Paste the key below and set the model to deepseek-chat;&#xA;3. Click "Save and test", then return to the home page to chat.&#xA;Any compatible /chat/completions relay and model name also works.</sys:String>
    <sys:String x:Key="Setup.Ai.BaseUrl">API base URL</sys:String>
    <sys:String x:Key="Setup.Ai.Model">Model</sys:String>
    <sys:String x:Key="Setup.Ai.ApiKey">API key</sys:String>
    <sys:String x:Key="Setup.Ai.EnableTools">Allow the AI to operate the launcher (launch, switch versions, manage mods, open pages)</sys:String>
    <sys:String x:Key="Setup.Ai.AutoCrash">Automatically submit crash reports to the AI</sys:String>
    <sys:String x:Key="Setup.Ai.SaveAndTest">Save and test</sys:String>
    <sys:String x:Key="Setup.Ai.GetKey">Get API key</sys:String>
    <sys:String x:Key="Setup.Ai.Skip">Skip setup</sys:String>
    <sys:String x:Key="Setup.Ai.Abilities.Title">What the AI can do</sys:String>
    <sys:String x:Key="Setup.Ai.Abilities.Body">· Launch the game and switch versions&#xA;· Download and install Minecraft, Forge, NeoForge, Fabric and more&#xA;· Manage mods: list, enable, disable, delete&#xA;· Read game logs and crash reports and suggest fixes&#xA;· Open any page in the launcher</sys:String>
    <sys:String x:Key="Setup.Ai.Privacy.Title">Privacy</sys:String>
    <sys:String x:Key="Setup.Ai.Privacy.Body">The API key is stored encrypted in your local config and is only sent to the API base URL you provide. Logs and crash reports are submitted only when you or automatic analysis triggers them.</sys:String>
    <sys:String x:Key="Setup.Ai.Status.Configured">API key configured. Return to the home page to chat.</sys:String>
    <sys:String x:Key="Setup.Ai.Status.NotConfigured">No API key configured yet.</sys:String>
    <sys:String x:Key="Setup.Ai.Status.Saved">Saved.</sys:String>
    <sys:String x:Key="Setup.Ai.Status.Testing">Testing connection...</sys:String>
    <sys:String x:Key="Setup.Ai.Status.Connected">Connection succeeded.</sys:String>
    <sys:String x:Key="Setup.Ai.Error.BaseUrl">API base URL cannot be empty.</sys:String>
    <sys:String x:Key="Setup.Ai.Error.Model">Model name cannot be empty.</sys:String>
    <sys:String x:Key="Setup.Ai.Error.ApiKey">API key cannot be empty.</sys:String>
    <sys:String x:Key="Setup.Ai.Error.Save">Save failed</sys:String>
    <sys:String x:Key="Setup.Ai.Error.Test">Test failed</sys:String>
    <sys:String x:Key="Setup.Ai.Error.OpenBrowser">Cannot open the browser</sys:String>
    <sys:String x:Key="Launch.Account.Microsoft.Error.ClientIdMissing">This build has no Microsoft OAuth client ID (PCL_MS_CLIENT_ID) configured, so Microsoft sign-in is unavailable. Go back and use offline or third-party login; official release builds include this configuration.</sys:String>
    <sys:String x:Key="Minecraft.Launch.Login.Microsoft.AppNotApproved.Message">This Azure app has not been approved by Mojang for the Minecraft API (invalid app registration). Submit it for review first; Microsoft sign-in cannot complete until it is approved.</sys:String>
    <sys:String x:Key="Minecraft.Launch.Login.Microsoft.AppNotApproved.Open">Open review page</sys:String>
</ResourceDictionary>